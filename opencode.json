{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "firebase": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "firebase-tools@latest",
          "mcp",
          "--only",
          "auth,firestore,hosting"
        ],
        "timeout": {
          "startup": 60000
        }
      }
    }
  }
}
