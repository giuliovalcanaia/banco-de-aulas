# Configuração pública do app web Firebase.
# Console do Firebase > Configurações do projeto > Seus apps > Web.
#
# Estes valores NÃO são segredos: identificam o projeto e ficam visíveis em
# qualquer app Firebase compilado. A proteção real está em firestore.rules.
#
# Em desenvolvimento, copie este arquivo para .env.local.
# No CI (GitHub Actions), defina cada variável como Variable do repositório.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=SEU_PROJETO.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=SEU_PROJETO
VITE_FIREBASE_STORAGE_BUCKET=SEU_PROJETO.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Opcional: use os emuladores locais em vez do projeto real.
VITE_USE_FIREBASE_EMULATOR=false
