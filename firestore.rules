rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // A sessão do app dura 30 dias a partir do login. O Firebase renova o ID
    // token sozinho, mas auth_time continua sendo o horário do login.
    function sessionValid() {
      return request.auth.token.auth_time is int
        && request.time.toMillis() < request.auth.token.auth_time * 1000 + 2592000000;
    }

    // Qualquer conta Google autenticada e verificada pode usar o app. O
    // isolamento fica por conta do uid: cada usuário só acessa users/{uid}/...,
    // garantido por isOwner().
    function isAuthorized() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && sessionValid();
    }

    function isOwner(uid) {
      return isAuthorized() && request.auth.uid == uid;
    }

    function validTime(t) {
      return t is string
        && t.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$');
    }

    function validRange(r) {
      return r == null
        || (r is map
            && validTime(r.get('start', ''))
            && validTime(r.get('end', '')));
    }

    function validEntry(data, date) {
      return data.get('date', '') == date
        && date.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && validRange(data.get('morning', null))
        && validRange(data.get('afternoon', null))
        && data.get('note', '') is string
        && data.get('note', '').size() <= 500;
    }

    function validSettings(data) {
      return validRange(data.get('defaultMorning', null))
        && validRange(data.get('defaultAfternoon', null))
        && data.get('minutesPerAula', 0) is number
        && data.get('minutesPerAula', 0) > 0
        && data.get('workdays', []) is list
        && data.get('workdays', []).size() > 0
        && data.get('workdays', []).size() <= 7;
    }

    match /users/{uid}/entries/{date} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid) && validEntry(request.resource.data, date);
      allow delete: if isOwner(uid);
    }

    match /users/{uid}/settings/{docId} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid) && docId == 'main' && validSettings(request.resource.data);
    }

    match /users/{uid}/{document=**} {
      allow read, write: if false;
    }
  }
}
