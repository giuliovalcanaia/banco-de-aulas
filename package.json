{
  "name": "banco-de-aulas",
  "private": true,
  "version": "0.1.0",
  "description": "Controle pessoal de banco de horas docentes, medido em aulas.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && tsc -p tsconfig.server.json && vite build",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:notif": "node scripts/test-notification.mjs",
    "test:rules": "npx --yes firebase-tools@15.35.0 emulators:exec --only firestore \"vitest run --config vitest.rules.config.ts\"",
    "emulators": "npx --yes firebase-tools@15.35.0 emulators:start --only auth,firestore",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@tailwindcss/vite": "^4.3.4",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "firebase": "^12.10.0",
    "google-auth-library": "^11.3.3",
    "jose": "^6.2.15",
    "lucide-react": "^1.69.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.4",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vercel/node": "^29.0.1",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "shadcn": "^4.23.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
